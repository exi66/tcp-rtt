<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TcpRtt</RootNamespace>
    <AssemblyName>TcpRtt</AssemblyName>
    <ApplicationIcon>Resources\favicon.ico</ApplicationIcon>
    <!-- ScottPlot.WinForms pulls OpenTK/SkiaSharp views built for .NET Framework; they work fine here. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!-- Used by `dotnet publish -p:PublishSingleFile=true` (see .github/workflows/release.yml). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.58" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TcpRtt.Tests" />
  </ItemGroup>

</Project>
